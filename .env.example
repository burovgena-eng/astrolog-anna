# Скопируйте этот файл в .env и заполните значения: cp .env.example .env

# Строка подключения Prisma (SQLite).
# Путь указывается ОТНОСИТЕЛЬНО папки prisma/, поэтому ../db/custom.db
# создаёт файл базы в <корень проекта>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# Пароль панели администратора /admin (обязателен; используйте длинную случайную строку)
ADMIN_PASSWORD="change-me-to-a-long-random-string"

# Секрет для подписи админ-сессий (HMAC-SHA256). Сгенерировать: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-random-secret"
